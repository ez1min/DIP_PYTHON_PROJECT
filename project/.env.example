KAKAO_MAP_APP_KEY=your_kakao_javascript_key
JWT_SECRET=replace_with_a_long_random_secret

# No-IP hostname without a scheme or path.
PUBLIC_HOST=your-hostname.ddns.net
PUBLIC_ORIGIN=http://your-hostname.ddns.net

# HTTP bootstrap: forward public TCP 80 to this PC's TCP 8010.
HTTP_PORT=8010
HTTPS_PORT=8443
NGINX_CONFIG=./deploy/nginx-http.conf.template

# After issuing the certificate, forward public TCP 443 to TCP 8443 and use:
# PUBLIC_ORIGIN=https://your-hostname.ddns.net
# NGINX_CONFIG=./deploy/nginx-https.conf.template

# Optional temporary external HTTPS URL from Cloudflare Quick Tunnel.
TUNNEL_HOST=random-name.trycloudflare.com
TUNNEL_ORIGIN=https://random-name.trycloudflare.com
